## Shared
SPRING_PROFILES_ACTIVE=prod
APP_CORS_ALLOWED_ORIGINS=http://YOUR_FRONTEND_DOMAIN
EUREKA_CLIENT_ENABLED=true
EUREKA_SERVER_URL=http://YOUR_EC2_PRIVATE_IP:8761/eureka/
RABBITMQ_HOST=YOUR_RABBITMQ_HOST
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

## MySQL credentials (use dedicated users/passwords in production)
DB_USERNAME=resumeai_user
DB_PASSWORD=change_me

## Service DB URLs (set per service env file/shell before startup)
SPRING_DATASOURCE_URL=jdbc:mysql://YOUR_DB_HOST:3306/auth_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_URL=jdbc:mysql://YOUR_DB_HOST:3306/service_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

## Security
JWT_SECRET=change_me_with_min_32_chars_random_secret
APP_FRONTEND_BASE_URL=http://YOUR_FRONTEND_DOMAIN
APP_OAUTH2_SUCCESS_REDIRECT_URL=http://YOUR_FRONTEND_DOMAIN/oauth/callback
APP_OAUTH2_FAILURE_REDIRECT_URL=http://YOUR_FRONTEND_DOMAIN/login
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_REDIRECT_URI=http://YOUR_GATEWAY_DOMAIN/login/oauth2/code/google

## OAuth / Payments / AI keys
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
