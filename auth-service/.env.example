# Auth Service environment template
# Copy this file to .env and fill real values.
# Do not commit .env

# Server
SERVER_PORT=8080

# Database
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/auth_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=your_mysql_username
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# JPA
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# Eureka
EUREKA_CLIENT_ENABLED=false
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka

# JWT
JWT_SECRET=replace_with_a_strong_secret_at_least_32_chars
JWT_EXPIRATION=86400000

# Frontend / OAuth redirects
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_FRONTEND_BASE_URL=http://localhost:3000
APP_OAUTH2_SUCCESS_REDIRECT_URL=http://localhost:3000/oauth/callback
APP_OAUTH2_FAILURE_REDIRECT_URL=http://localhost:3000/login

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
